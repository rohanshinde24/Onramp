# Copy to .env for local development. Placeholders only; never commit real values.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://onramp:change-me@localhost:5432/onramp
MARKETPLACE_DATABASE_URL=postgresql+psycopg://onramp:change-me@localhost:5432/marketplace
# Optional. Unset means telemetry is exported nowhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-a-random-value-of-at-least-32-chars
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
ELASTICSEARCH_URL=http://127.0.0.1:9200
